# Postgres
POSTGRES_USER=tricouture
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=tricouture
# DATABASE_URL utilisé par l'app (host = nom du service compose "db")
DATABASE_URL=postgres://tricouture:change-me-please@db:5432/tricouture

# App — URL publique réelle (doit correspondre à ce que voit le navigateur).
# Remplace par TON domaine en production, ex. https://tricouture.exemple.fr
ORIGIN=http://localhost:3000
# Secret pour signer les sessions (générer: openssl rand -hex 32)
AUTH_SECRET=change-me-32-bytes-hex

# Chemin de stockage des fichiers uploadés (monté en volume)
MEDIA_DIR=/data/media

# Taille maximale d'un envoi, en octets. adapter-node plafonne à 512 Ko par
# défaut, ce qui refuse (erreur 413) un PDF de patron un peu lourd et rend
# l'import en lot impossible. 100 Mo ici ; monte si tes PDF sont plus gros.
BODY_SIZE_LIMIT=104857600

# --- Phases IA (sidecars GPU), optionnel pour le socle ---
# Laisse OLLAMA_URL vide pour désactiver l'IA (les boutons renvoient un message clair).
OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
VISION_URL=http://vision:8000
WHISPER_URL=http://whisper:9000
SD_URL=http://sd:8002
# Modèle SD (HuggingFace ID). Défaut SD 2.1-base (~4 GB VRAM, bon équilibre).
SD_MODEL_ID=stabilityai/stable-diffusion-2-1-base
# HF_TOKEN=hf_xxx  # seulement si le modèle est privé/gate

# --- Exposition Internet (optionnel) ---
# Cloudflare Tunnel (voir docs/SELF-HOSTING.md §7) :
CLOUDFLARE_TUNNEL_TOKEN=

# --- Surveillance mensuelle des modèles (scripts/model-watch/, voir son README) ---
# Jeton requis pour déclencher /api/cron/model-watch (générer avec
# openssl rand -hex 32). Laisse vide pour désactiver la fonctionnalité.
MODEL_WATCH_TOKEN=
# Optionnel : sans ces variables SMTP, le rapport est seulement enregistré
# sur disque dans scripts/model-watch/reports/, pas envoyé par email.
MODEL_WATCH_SMTP_HOST=
MODEL_WATCH_SMTP_PORT=587
MODEL_WATCH_SMTP_USER=
MODEL_WATCH_SMTP_PASSWORD=
MODEL_WATCH_SMTP_FROM=
MODEL_WATCH_SMTP_TO=
MODEL_WATCH_SMTP_USE_TLS=true
# Marge de sécurité (Go) retranchée à la VRAM totale mesurée pour obtenir le
# budget des modèles candidats.
MODEL_WATCH_VRAM_HEADROOM_GB=1.0
# Nombre de modèles candidats testés par run (chacun peut peser plusieurs Go
# à télécharger — garder ce nombre bas si la bande passante est limitée).
MODEL_WATCH_MAX_CANDIDATES=3
# Écart de score minimal (sur 100) pour qu'un candidat soit jugé "vraiment
# meilleur" et remplace le modèle actuel, plutôt qu'un bruit de mesure.
MODEL_WATCH_MIN_IMPROVEMENT=5.0
